@page "/preview/{token}"
@model PreviewModel
@{
    Layout = "_PublicLayout";
    var site = Model.Site;
    ViewData["Lang"] = site.Language;
    ViewData["Title"] = $"{PublicText.Get(site.Language, "preview.banner")} · {site.Slug}";
    ViewData["Robots"] = "noindex, nofollow, noarchive";
    ViewData["BodyClass"] = $"palette-{site.Palette.Key}";
}
<div class="bg-site-text px-4 py-2 text-center text-sm text-site-bg">@PublicText.Get(site.Language, "preview.banner") · /@site.Slug</div>
<partial name="_SiteBody" model="site" />
