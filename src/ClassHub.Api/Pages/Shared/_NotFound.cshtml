@* Body of a public 404 (unknown or unpublished site). The model is the language. *@
@model string
<main class="mx-auto flex min-h-dvh max-w-xl flex-col items-center justify-center gap-4 px-4 text-center">
    <h1 class="text-2xl font-bold text-site-primary">@PublicText.Get(Model, "notFound.title")</h1>
    <p class="text-site-muted">@PublicText.Get(Model, "notFound.text")</p>
    <a href="/" class="rounded-full bg-site-primary px-5 py-2 font-semibold text-site-on-primary">@PublicText.Get(Model, "notFound.home")</a>
</main>
