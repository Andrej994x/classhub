{
    "name": "classhub-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "oxlint --deny-warnings src scripts e2e playwright.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "i18n:check": "node scripts/check-i18n.mjs",
        "api:types": "openapi-typescript src/api/openapi.json --output src/api/schema.d.ts",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@hookform/resolvers": "^7.0.2",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-slot": "^1.5.0",
        "@tanstack/react-query": "^5.105.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.7.1",
        "lucide-react": "^1.68.0",
        "openapi-fetch": "^0.17.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-i18next": "^17.1.12",
        "react-router": "^8.5.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "jsdom": "^30.1.3",
        "openapi-typescript": "^7.13.0",
        "oxlint": "^1.91.0",
        "tailwindcss": "^4.3.4",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
